<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE params SYSTEM "params.dtd">


<params name="MPA11 Championship" version="2.2">
  <section name="Header">
    <attstr name="name" val="MPA11 Championship"/>
    <attstr name="type" val="Championship"/>
    <attstr name="subtype" val="MPA11"/>
    <attstr name="description" val="MPA11 Championship"/>
    <attnum name="priority" val="60"/>
    <attstr name="menu image" val="data/img/splash-champ.jpg"/>
    <attstr name="run image" val="data/img/splash-run-practice.jpg"/>
    <attstr name="start image" val="data/img/splash-champstart.jpg"/>
  </section>

  <section name="Tracks">
    <attnum name="maximum number" val="20"/>
    <section name="1">
      <attstr name="name" val="peters"/>
      <attstr name="category" val="road"/>
    </section>

    <section name="2">
      <attstr name="name" val="newton"/>
      <attstr name="category" val="speedway"/>
    </section>

    <section name="3">
      <attstr name="name" val="brondehach"/>
      <attstr name="category" val="circuit"/>
    </section>

    <section name="4">
      <attstr name="name" val="longpond"/>
      <attstr name="category" val="speedway"/>
    </section>

    <section name="5">
      <attstr name="name" val="milky-five"/>
      <attstr name="category" val="speedway"/>
    </section>

    <section name="6">
      <attstr name="name" val="corkscrew"/>
      <attstr name="category" val="circuit"/>
    </section>

    <section name="7">
      <attstr name="name" val="arizona"/>
      <attstr name="category" val="speedway"/>
    </section>

    <section name="8">
      <attstr name="name" val="pinabashi"/>
      <attstr name="category" val="road"/>
    </section>

    <section name="9">
      <attstr name="name" val="karwada"/>
      <attstr name="category" val="circuit"/>
    </section>

    <section name="10">
      <attstr name="name" val="espie"/>
      <attstr name="category" val="circuit"/>
    </section>

    <section name="11">
      <attstr name="name" val="manton"/>
      <attstr name="category" val="speedway"/>
    </section>

    <section name="12">
      <attstr name="name" val="street-1"/>
      <attstr name="category" val="road"/>
    </section>

    <section name="13">
      <attstr name="name" val="sunshine"/>
      <attstr name="category" val="speedway"/>
    </section>

  </section>

  <section name="Races">
    <section name="1">
      <attstr name="name" val="Free Practice"/>
    </section>

    <section name="2">
      <attstr name="name" val="Qualifying"/>
    </section>

    <section name="3">
      <attstr name="name" val="Warm-up"/>
    </section>

    <section name="4">
      <attstr name="name" val="Race"/>
    </section>

  </section>

  <section name="All Sessions">
    <attstr name="rain" val="random"/>
    <attstr name="clouds" val="random"/>
    <attstr name="weather" val="config"/>
  </section>

  <section name="Free Practice">
    <attnum name="sessiontime" unit="s" val="1200"/>
    <attnum name="laps" val="0"/>
    <attnum name="distance" unit="km" val="40"/>
    <attstr name="type" val="practice"/>
    <attstr name="starting order" val="drivers list"/>
    <attstr name="display mode" val="results only"/>
    <attstr name="restart" val="no"/>
    <attstr name="display results" val="yes"/>
    <attstr name="must complete" val="no"/>
    <attstr name="time of day" val="morning"/>
    <attstr name="rain" val="random"/>
    <attstr name="clouds" val="random"/>
    <section name="Starting Grid">
      <attnum name="rows" val="1"/>
      <attnum name="distance to start" val="100"/>
      <attnum name="distance between columns" val="20"/>
      <attnum name="offset within a column" val="10"/>
      <attnum name="initial speed" val="0"/>
      <attnum name="initial height" val="0.2"/>
    </section>

  </section>

  <section name="Qualifying">
    <attnum name="laps" val="3"/>
    <attstr name="type" val="qualifications"/>
    <attstr name="starting order" val="drivers list"/>
    <attstr name="display mode" val="results only"/>
    <attstr name="restart" val="no"/>
    <attstr name="display results" val="yes"/>
    <attstr name="must complete" val="yes"/>
    <attnum name="maximum drivers" val="30"/>
    <attstr name="time of day" val="afternoon"/>
    <attstr name="rain" val="random"/>
    <attstr name="clouds" val="random"/>
    <section name="Starting Grid">
      <attnum name="rows" val="1"/>
      <attnum name="distance to start" val="100"/>
      <attnum name="distance between columns" val="100"/>
      <attnum name="offset within a column" val="10"/>
      <attnum name="initial speed" val="0"/>
      <attnum name="initial height" val="0.2"/>
    </section>

    <section name="Points">
      <section name="1">
        <attnum name="points" val="1"/>
      </section>

    </section>

  </section>

  <section name="Warm-up">
    <attnum name="sessiontime" unit="s" val="600"/>
    <attnum name="laps" val="0"/>
    <attnum name="distance" unit="km" val="15"/>
    <attstr name="type" val="practice"/>
    <attstr name="starting order" val="Qualifying"/>
    <attstr name="display mode" val="results only"/>
    <attstr name="restart" val="no"/>
    <attnum name="maximum drivers" val="20"/>
    <attstr name="display results" val="yes"/>
    <attstr name="must complete" val="no"/>
    <attstr name="time of day" val="morning"/>
    <attstr name="rain" val="random"/>
    <attstr name="clouds" val="random"/>
    <section name="Starting Grid">
      <attnum name="rows" val="1"/>
      <attnum name="distance to start" val="100"/>
      <attnum name="distance between columns" val="100"/>
      <attnum name="offset within a column" val="10"/>
      <attnum name="initial speed" val="0"/>
      <attnum name="initial height" val="0.2"/>
    </section>

  </section>

  <section name="Race">
    <attnum name="distance" unit="km" val="60"/>
    <attstr name="type" val="race"/>
    <attstr name="starting order" val="Qualifying"/>
    <attstr name="restart" val="no"/>
    <attnum name="maximum drivers" val="20"/>
    <attstr name="splash menu" val="yes"/>
    <attstr name="must complete" val="no"/>
    <attstr name="time of day" val="afternoon"/>
    <attstr name="rain" val="random"/>
    <attstr name="clouds" val="random"/>
    <section name="Starting Grid">
      <attnum name="rows" val="2"/>
      <attnum name="distance to start" val="1"/>
      <attnum name="distance between columns" val="16"/>
      <attnum name="offset within a column" val="8"/>
      <attnum name="initial speed" val="0"/>
      <attnum name="initial height" val="0.2"/>
    </section>

    <section name="Points">
      <section name="1">
        <attnum name="points" val="20"/>
      </section>

      <section name="2">
        <attnum name="points" val="16"/>
      </section>

      <section name="3">
        <attnum name="points" val="14"/>
      </section>

      <section name="4">
        <attnum name="points" val="12"/>
      </section>

      <section name="5">
        <attnum name="points" val="10"/>
      </section>

      <section name="6">
        <attnum name="points" val="8"/>
      </section>

      <section name="7">
        <attnum name="points" val="6"/>
      </section>

      <section name="8">
        <attnum name="points" val="5"/>
      </section>

      <section name="9">
        <attnum name="points" val="4"/>
      </section>

      <section name="10">
        <attnum name="points" val="3"/>
      </section>

      <section name="11">
        <attnum name="points" val="2"/>
      </section>

      <section name="12">
        <attnum name="points" val="1"/>
      </section>

    </section>

  </section>

  <section name="Drivers">
    <attnum name="maximum number" val="50"/>
    <attstr name="rejected types" val="networkhuman"/>
    <attstr name="accepted categories" val="MPA11"/>
    <section name="1">
      <attstr name="driver name" val="Player"/>
      <attstr name="module" val="human"/>
    </section>
  </section>

  <section name="Configuration">
    <attnum name="current configuration" val="2"/>
    <section name="1">
      <attstr name="type" val="drivers select"/>
    </section>

    <section name="2">
      <attstr name="type" val="race config"/>
      <attstr name="race" val="Free Practice"/>
      <section name="Options">
        <section name="1">
          <attstr name="type" val="race length"/>
        </section>
        <section name="2">
          <attstr name="type" val="cloud cover"/>
        </section>
        <section name="3">
          <attstr name="type" val="rain fall"/>
        </section>
      </section>
    </section>

    <section name="3">
      <attstr name="type" val="race config"/>
      <attstr name="race" val="Qualifying"/>
      <section name="Options">
        <section name="1">
          <attstr name="type" val="race length"/>
        </section>
        <section name="2">
          <attstr name="type" val="cloud cover"/>
        </section>
        <section name="3">
          <attstr name="type" val="rain fall"/>
        </section>
      </section>
    </section>

    <section name="4">
      <attstr name="type" val="race config"/>
      <attstr name="race" val="Warm-up"/>
      <section name="Options">
        <section name="1">
          <attstr name="type" val="race length"/>
        </section>
        <section name="2">
          <attstr name="type" val="cloud cover"/>
        </section>
        <section name="3">
          <attstr name="type" val="rain fall"/>
        </section>
      </section>
    </section>

    <section name="5">
      <attstr name="type" val="race config"/>
      <attstr name="race" val="Race"/>
      <section name="Options">
        <section name="1">
          <attstr name="type" val="race length"/>
        </section>
        <section name="2">
          <attstr name="type" val="cloud cover"/>
        </section>
        <section name="3">
          <attstr name="type" val="rain fall"/>
        </section>
      </section>
    </section>

  </section>

</params>
