<!DOCTYPE params SYSTEM "../../libs/tgf/params.dtd">

<params name="networking" type="param" mode="mw" version="1.0">
    <section name="Network Server Settings">
       <attnum name="port" val="28500"/>
    </section>

    <!-- VR: the dedicated server this build races on. The stock file points at
         127.0.0.1, which is useless on a headset - there is no server on it, and
         typing an address on the on-screen keyboard is miserable. This file is
         not in data/user-files so it is never copied into the user directory;
         the menu reads it from here, and anything typed into the client settings
         screen still overrides it for that session. -->
    <section name="Network Client Settings">
      <attstr name="ip4" val="217.154.211.69"/>
       <attnum name="port" val="28500"/>
    </section>

    <!-- VR: ad-hoc races. Players host races on their own headsets; these
         relays list the open races and carry the traffic to and from them
         (tools/server/adhoc). The backup is used whenever the primary does
         not answer. -->
    <section name="Ad-hoc Relays">
      <attstr name="primary" val="217.154.211.69"/>
      <attstr name="backup" val="85.215.158.219"/>
      <attnum name="port" val="28500"/>
    </section>
</params>
